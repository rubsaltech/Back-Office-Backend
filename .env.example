# ============================================================================
# RUBSAL POS — Backend environment variables
# ----------------------------------------------------------------------------
# These are consumed by application.yml via ${VAR} placeholders.
# LOCAL DEV: you don't need any of these — the defaults in application.yml
#            already point at the docker-compose Postgres. Only set them to
#            override.
# PRODUCTION (Render): set each of these in the service's "Environment" tab.
#            DO NOT commit real values — this file is a template only.
# ============================================================================

# --- Database (Neon) ---
# Neon gives you a connection string like:
#   postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
# Split it into the three vars below. Keep ?sslmode=require on the JDBC URL.
DB_URL=jdbc:postgresql://ep-xxx.eu-central-1.aws.neon.tech/rubsal_pos?sslmode=require
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password

# --- Security ---
# 256-bit+ Base64 secret. Generate one, e.g.:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_base64_secret_at_least_32_bytes
JWT_ACCESS_TTL=PT30M     # ISO-8601 duration (30 minutes)
JWT_REFRESH_TTL=P14D     # 14 days

# --- CORS ---
# Comma-separated list of allowed frontend origins (your Render static site URL).
CORS_ORIGINS=https://rubsal-pos.onrender.com

# --- Email (Gmail SMTP) for the forgot-password OTP ---
# Requires a Gmail account with 2-Step Verification ON, then an "App Password"
# (Google Account → Security → App passwords). Use that 16-char password, NOT
# your normal Gmail password. Leave blank to disable email (OTP is logged instead).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=youraddress@gmail.com
MAIL_FROM_NAME=RUBSAL POS

# --- Demo data ---
# Seeds the "Rubsal Store" demo business on an EMPTY database (great for dev).
# Set to false in production so it never creates the demo tenant.
APP_SEED_DEMO=false

# --- Server / uploads ---
# Render injects PORT automatically; you usually don't set it.
# PORT=8080
# Uploaded files are stored here. On Render this disk is EPHEMERAL (wiped on
# each deploy) — move to S3/object storage before relying on it in production.
UPLOADS_DIR=./uploads
